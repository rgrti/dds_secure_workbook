<?xml version="1.0" encoding="UTF-8"?>

<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/6.1.0/dds_security_permissions.xsd">

    <permissions>

        <grant name="demo_appPermissions">

            <!-- TODO: Change the fields below to match those in your appname.cnf file.  Change 'demo_app' to your app's name -->
            <subject_name>/C=US/ST=CA/O=Real Time Innovations/CN=demo_app/emailAddress=demo_app@rti.com</subject_name>

            <validity>
                <!-- Format is CCYY-MM-DDThh:mm:ss[Z|(+|-)hh:mm] in GMT -->
                <not_before>2013-06-01T13:00:00</not_before>
                <not_after>2033-06-01T13:00:00</not_after>
            </validity>

            <allow_rule>
                <domains>
                    <id_range>
                        <min>0</min>
                        <max>6</max>
                    </id_range>
                </domains>
                <publish>
                    <partitions>
                        <partition>*</partition>
                    </partitions>
                    <topics>
                        <topic>*</topic>
                    </topics>
                </publish>
                <subscribe>
                    <partitions>
                        <partition>*</partition>
                    </partitions>
                    <topics>
                        <topic>*</topic>
                    </topics>
                </subscribe>
            </allow_rule>

            <deny_rule>
                <domains>
                    <id_range>
                        <min>0</min>
                        <max>6</max>
                    </id_range>
                </domains>

                <publish>
                    <partitions>
                        <partition>*</partition>
                    </partitions>
                    <topics>
                        <topic>secure_topic_this_app_can_NOT_write</topic>
                        <topic>secure_topic_this_app_can_NOT_write</topic>
                    </topics>
                </publish>

                <subscribe>
                    <partitions>
                        <partition>*</partition>
                    </partitions>
                    <topics>
                        <topic>secure_topic_this_app_can_NOT_read</topic>
                        <topic>secure_topic_this_app_can_NOT_read</topic>
                    </topics>
                </subscribe>

            </deny_rule>

            <default>DENY</default>

        </grant>
    </permissions>
</dds>

