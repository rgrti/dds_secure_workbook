<?xml version="1.0" encoding="UTF-8"?>

<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/7.2.0/dds_security_permissions.xsd">

    <permissions>

        <grant name="triwriterPermissions">

            <subject_name>/C=US/ST=CA/O=Real Time Innovations/CN=triwriter/emailAddress=triwriter@rti.com</subject_name>

            <validity>
                <!-- Format is CCYY-MM-DDThh:mm:ss[Z|(+|-)hh:mm] in GMT -->
                <not_before>2013-06-01T13:00:00</not_before>
                <not_after>2033-06-01T13:00:00</not_after>
            </validity>

            <allow_rule>
                <domains>
                    <id_range>
                        <min>0</min>
                        <max>9</max>
                    </id_range>
                </domains>
                <publish>
                    <partitions>
                        <partition>*</partition>
                    </partitions>
                    <topics>
                        <topic>*</topic>
                    </topics>
                </publish>
                <subscribe>
                    <partitions>
                        <partition>*</partition>
                    </partitions>
                    <topics>
                        <topic>*</topic>
                    </topics>
                </subscribe>
            </allow_rule>

            <default>DENY</default>

        </grant>
    </permissions>
